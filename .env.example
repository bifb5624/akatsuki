# 公開先のHTTPS URL。末尾にパスを付けない。
APP_ORIGIN=https://example.invalid
APP_TRUST_PROXY_HOPS=1

# 32文字以上の別々の秘密値。実際の値は公開先の秘密変数へ登録する。
APP_AUTH_SECRET=
APP_SETUP_TOKEN=

# Tursoの管理画面で発行する。GitHubやObsidianへ実際の値を保存しない。
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Googleドライブ接続時に設定する。現在は未接続。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
